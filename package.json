{
  "name": "ordersync-api",
  "version": "0.1.0",
  "description": "Webhook integration service for e-commerce orders with a secure REST API.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U ordersync -d ordersync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matkalil/ordersync-api.git"
  },
  "keywords": [],
  "author": "Mateus Kuhnen Kalil",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Matkalil/ordersync-api/issues"
  },
  "homepage": "https://github.com/Matkalil/ordersync-api#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0"
  }
}
